-- TARGET-LOCKED AUTO TELEPORT
task.spawn(function()
    while Running and gui.Parent do

        if Enabled then
            TargetName = search.Text

            if TargetName ~= "" then
                local npc = FindNPC(TargetName)

                if npc then
                    -- Lock this exact NPC for the entire cycle.
                    UpdateStatus("Locked onto: " .. npc.Name)

                    local success, message = TeleportToNPC(npc)

                    if success then
                        UpdateStatus("Waiting for " .. npc.Name .. " to be defeated")

                        -- Do not select another NPC while this one is alive.
                        while Running and Enabled and IsAlive(npc) do
                            task.wait(0.1)
                        end

                        if Running and Enabled then
                            UpdateStatus("NPC defeated! Waiting for respawn")
                        end
                    else
                        UpdateStatus(
                            message,
                            Color3.fromRGB(255, 110, 110)
                        )

                        task.wait(0.25)
                    end
                else
                    UpdateStatus(
                        "Waiting for NPC respawn...",
                        Color3.fromRGB(230, 190, 100)
                    )

                    task.wait(0.25)
                end
            else
                UpdateStatus("Enter an NPC name!", Color3.fromRGB(255, 110, 110))
                task.wait(0.25)
            end

            -- Delay between completed target cycles.
            if Running and Enabled then
                task.wait(1 / TeleportsPerSecond)
            end
        else
            task.wait(0.1)
        end
    end
end)
