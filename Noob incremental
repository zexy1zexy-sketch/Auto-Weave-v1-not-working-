task.spawn(function()
    while Running and gui.Parent do
        if Enabled then
            TargetName = search.Text

            if TargetName ~= "" then
                local success, message = TeleportToNPC()

                if success then
                    UpdateStatus(message)
                else
                    UpdateStatus(message, Color3.fromRGB(255, 110, 110))
                end
            end
        end

        task.wait(1 / TeleportsPerSecond)
    end
end)
