-- CHARACTER HELPERS

local function Stabilize(Character)
    local Root = GetRoot(Character)

    if Root then
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function TeleportToNPC(NPC)
    local Character = Player.Character
    local NPCRoot = GetRoot(NPC)

    if not Character or not Character.Parent or not NPCRoot then
        return false
    end

    Character:PivotTo(NPCRoot.CFrame * CFrame.new(0, 0, 4))
    return true
end

-- UPWARD TELEPORT

local function GoUpAndReturn(IsAuto, Generation)
    local Character = Player.Character

    if not Character or not Character.Parent then
        return false
    end

    local OriginalPosition = Character:GetPivot()
    local WentUp = false

    local Success, ErrorMessage = pcall(function()
        Character:PivotTo(
            OriginalPosition + Vector3.new(0, AirHeight, 0)
        )

        WentUp = true
        Stabilize(Character)

        local EndTime = os.clock() + AirTime

        while Running and os.clock() < EndTime do
            if IsAuto and (
                not AutoEnabled
                or Generation ~= AutoGeneration
            ) then
                break
            end

            local Remaining = math.max(0, EndTime - os.clock())

            if IsAuto then
                SetStatus(
                    "AUTO TPING | AIRBORNE " ..
                    string.format("%.1f", Remaining) .. "s"
                )
            else
                SetStatus(
                    "AIRBORNE | " ..
                    string.format("%.1f", Remaining) .. "s"
                )
            end

            task.wait(0.1)
        end
    end)

    if WentUp and Character.Parent then
        pcall(function()
            Character:PivotTo(OriginalPosition)
            Stabilize(Character)
        end)
    end

    if not Success then
        SetStatus("Error: " .. tostring(ErrorMessage))
        return false
    end

    return true
end

-- MANUAL TELEPORT

TeleportButton.MouseButton1Click:Connect(function()
    if CycleBusy then
        SetStatus("Already performing a cycle")
        return
    end

    local NPC = FindNPC(TargetName)

    if not NPC then
        SetStatus("NPC not found")
        return
    end

    task.spawn(function()
        CycleBusy = true

        if TeleportToNPC(NPC) then
            SetStatus("Manual TP | Waiting for air interval")
            task.wait(AirInterval)

            if Running then
                GoUpAndReturn(false, 0)
            end
        end

        CycleBusy = false
        if Running then SetStatus("Ready") end
    end)
end)

-- CONTINUOUS AUTO TP WITH SEPARATE AIR TIMER

local function StartAuto()
    AutoGeneration += 1
    local Generation = AutoGeneration

    task.spawn(function()
        LockedNPC = nil

        local NextAirTime = os.clock() + AirInterval

        while Running
            and AutoEnabled
            and Generation == AutoGeneration do

            if not IsAlive(LockedNPC) then
                LockedNPC = FindNPC(TargetName)
            end

            if not LockedNPC or not IsAlive(LockedNPC) then
                SetStatus("Searching for " .. TargetName)
                task.wait(0.5)
                continue
            end

            if CycleBusy then
                task.wait(0.05)
                continue
            end

            CycleBusy = true

            local CurrentNPC = LockedNPC

            if not TeleportToNPC(CurrentNPC) then
                CycleBusy = false
                task.wait(0.1)
                continue
            end

            SetStatus("AUTO TPING | " .. CurrentNPC.Name)

            -- Check the independent upward teleport timer.
            if os.clock() >= NextAirTime then
                SetStatus("AUTO TPING | Going UP")

                GoUpAndReturn(true, Generation)

                -- Start the next air interval after returning.
                NextAirTime = os.clock() + AirInterval
            end

            CycleBusy = false

            -- This controls NPC teleport frequency.
            if AutoEnabled and Generation == AutoGeneration then
                task.wait(1 / TeleportsPerSecond)
            end
        end

        CycleBusy = false
    end)
end

AutoButton.MouseButton1Click:Connect(function()
    AutoEnabled = not AutoEnabled

    if AutoEnabled then
        AutoButton.Text = "AUTO TP: ON"
        AutoButton.BackgroundColor3 = Color3.fromRGB(40, 165, 90)
        StartAuto()
    else
        AutoGeneration += 1
        AutoButton.Text = "AUTO TP: OFF"
        AutoButton.BackgroundColor3 = Color3.fromRGB(65, 135, 85)
        SetStatus("Auto TP disabled")
    end
end)

