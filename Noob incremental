local function WaitWithCountdown(Duration, Message)
    local EndTime = os.clock() + Duration

    while Running and os.clock() < EndTime do
        local Remaining = math.max(0, EndTime - os.clock())
        SetStatus(Message .. ": " .. string.format("%.1f", Remaining) .. "s")
        task.wait(math.min(0.1, Remaining))
    end

    return Running
end

local function Stabilize(Character)
    local Root = GetRoot(Character)
    if Root then
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function PerformCycle(NPC)
    if CycleBusy then
        return false
    end

    if not IsAlive(NPC) then
        return false
    end

    CycleBusy = true

    local Success, ErrorMessage = pcall(function()
        local Character = Player.Character
        if not Character or not Character.Parent then
            SetStatus("Waiting for character")
            return
        end

        local NPCRoot = GetRoot(NPC)
        if not NPCRoot then
            SetStatus("NPC root not found")
            return
        end

        Character:PivotTo(NPCRoot.CFrame * CFrame.new(0, 0, 4))
        task.wait(0.15)

        if not Character.Parent then
            return
        end

        local OriginalPosition = Character:GetPivot()

        if AirDelay > 0 then
            local Continued = WaitWithCountdown(
                AirDelay,
                "Waiting before air TP"
            )

            if not Continued or not Character.Parent then
                return
            end
        end

        SetStatus("Going up")
        Character:PivotTo(
            OriginalPosition + Vector3.new(0, AirHeight, 0)
        )
        Stabilize(Character)

        WaitWithCountdown(AirTime, "Airborne")

        if Character.Parent then
            SetStatus("Returning")
            Character:PivotTo(OriginalPosition)
            Stabilize(Character)
        end
    end)

    CycleBusy = false

    if not Success then
        SetStatus("Error: " .. tostring(ErrorMessage))
        return false
    end

    return true
end

TeleportButton.MouseButton1Click:Connect(function()
    if CycleBusy then
        SetStatus("A teleport cycle is already running")
        return
    end

    UpdateSearch()

    local NPC = FindNPC(TargetName)

    if not NPC then
        SetStatus("NPC not found")
        return
    end

    task.spawn(function()
        PerformCycle(NPC)
    end)
end)

local function StartAuto()
    AutoGeneration += 1
    local MyGeneration = AutoGeneration

    task.spawn(function()
        LockedNPC = nil

        while Running
            and AutoEnabled
            and MyGeneration == AutoGeneration do

            if not IsAlive(LockedNPC) then
                LockedNPC = nil
                LockedNPC = FindNPC(TargetName)
            end

            if LockedNPC and IsAlive(LockedNPC) then
                SetStatus("Locked onto " .. LockedNPC.Name)

                if not CycleBusy then
                    PerformCycle(LockedNPC)

                    local WaitTime = 1 / TeleportsPerSecond
                    task.wait(WaitTime)
                else
                    task.wait(0.1)
                end
            else
                SetStatus("Waiting for " .. TargetName)
                task.wait(0.5)
            end
        end
    end)
end

