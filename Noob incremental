local function GetRoot(model)
    if not model then return nil end

    return model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart
        or model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
end

local function IsAlive(model)
    if not model or not model.Parent then
        return false
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    return humanoid ~= nil and humanoid.Health > 0
end

-- NPC SEARCH
local function FindNPC(name)
    local search = string.lower(name)
    if search == "" then return nil end

    local best = nil
    local bestScore = -math.huge

    local playerRoot = GetRoot(Player.Character)

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model")
            and Players:GetPlayerFromCharacter(obj) == nil
            and IsAlive(obj) then

            local root = GetRoot(obj)

            if root then
                local modelName = string.lower(obj.Name)

                if modelName == search then
                    return obj
                end

                if string.find(modelName, search, 1, true) then
                    local distance = 0

                    if playerRoot then
                        distance = (root.Position - playerRoot.Position).Magnitude
                    end

                    local score = 100000 - (#modelName * 100) - distance

                    if score > bestScore then
                        best = obj
                        bestScore = score
                    end
                end
            end
        end
    end

    return best
end

-- REDUCE CHARACTER MOVEMENT JITTER
local function StabilizeCharacter(character)
    local root = GetRoot(character)
    if not root then return end

    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- AIR BOUNCE
local function AirBounce(character)
    if not AirBounceEnabled then
        return true
    end

    if not character or not character.Parent then
        return false
    end

    local originalPosition = character:GetPivot()

    StabilizeCharacter(character)

    character:PivotTo(
        originalPosition + Vector3.new(0, AirHeight, 0)
    )

    task.wait(AirTime)

    if character and character.Parent then
        StabilizeCharacter(character)
        character:PivotTo(originalPosition)
        StabilizeCharacter(character)
    end

    return true
end

-- TELEPORT
local function TeleportToNPC(npc)
    npc = npc or FindNPC(TargetName)

    if not npc or not IsAlive(npc) then
        return false, "NPC not found!"
    end

    local root = GetRoot(npc)
    local character = Player.Character

    if not root or not character then
        return false, "Character unavailable"
    end

    StabilizeCharacter(character)

    character:PivotTo(root.CFrame * CFrame.new(0, 0, 4))

    task.wait(0.1)

    if not character.Parent then
        return false, "Character respawned"
    end

    AirBounce(character)

    return true, "Target: " .. npc.Name
end

