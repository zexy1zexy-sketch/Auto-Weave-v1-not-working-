local function GetGuiParent()
    if typeof(gethui) == "function" then
        return gethui()
    end
    return game:GetService("CoreGui")
end

local GuiParent = GetGuiParent()
local OldGui = GuiParent:FindFirstChild("NoobIncrementalTP")
if OldGui then
    OldGui:Destroy()
end

local function GetRoot(Model)
    if not Model then return nil end

    return Model:FindFirstChild("HumanoidRootPart")
        or Model.PrimaryPart
        or Model:FindFirstChild("UpperTorso")
        or Model:FindFirstChild("Torso")
end

local function IsAlive(NPC)
    if not NPC or not NPC.Parent then
        return false
    end

    local Humanoid = NPC:FindFirstChildOfClass("Humanoid")
    local Root = GetRoot(NPC)

    return Humanoid ~= nil
        and Humanoid.Health > 0
        and Root ~= nil
end

local function FindNPC(Name)
    local Search = string.lower(Name or "")
    if Search == "" then return nil end

    local PartialMatch = nil

    for _, Object in ipairs(Workspace:GetDescendants()) do
        if Object:IsA("Model")
            and Object ~= Player.Character
            and not Players:GetPlayerFromCharacter(Object)
            and IsAlive(Object) then

            local ObjectName = string.lower(Object.Name)

            if ObjectName == Search then
                return Object
            end

            if not PartialMatch
                and string.find(ObjectName, Search, 1, true) then
                PartialMatch = Object
            end
        end
    end

    return PartialMatch
end

