local function GetRoot(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart
        or model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
end

local function FindNPC(name)
    local search = string.lower(name)
    local best, bestScore = nil, -1

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model")
            and Players:GetPlayerFromCharacter(obj) == nil then

            local root = GetRoot(obj)
            local humanoid = obj:FindFirstChildOfClass("Humanoid")

            if root and humanoid then
                local modelName = string.lower(obj.Name)
                if modelName == search then
                    return obj
                elseif string.find(modelName, search, 1, true) then
                    if #modelName > bestScore then
                        best = obj
                        bestScore = #modelName
                    end
                end
            end
        end
    end

    return best
end

local function TeleportToNPC()
    local npc = FindNPC(TargetName)
    if not npc then
        return false, "NPC not found!"
    end

    local root = GetRoot(npc)
    local character = Player.Character

    if not root or not character then
        return false, "Character unavailable"
    end

    character:PivotTo(root.CFrame * CFrame.new(0, 0, 4))

    return true, "Teleported to " .. npc.Name
end

