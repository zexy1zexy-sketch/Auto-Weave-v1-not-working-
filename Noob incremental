local function UpdateStatus(message, color)
    status.Text = "Status: " .. message
    status.TextColor3 = color or Color3.fromRGB(150, 220, 170)
end

search.FocusLost:Connect(function()
    if search.Text ~= "" then
        TargetName = search.Text
        local npc = FindNPC(TargetName)

        if npc then
            UpdateStatus("Found: " .. npc.Name)
        else
            UpdateStatus("NPC not found!", Color3.fromRGB(255, 110, 110))
        end
    end
end)

speedBox.FocusLost:Connect(function()
    local value = tonumber(speedBox.Text)

    if not value then
        value = 1
    end

    TeleportsPerSecond = math.clamp(math.floor(value), 1, 100)
    speedBox.Text = tostring(TeleportsPerSecond)

    UpdateStatus("Speed set to " .. TeleportsPerSecond .. " TPS")
end)

tpButton.MouseButton1Click:Connect(function()
    TargetName = search.Text

    if TargetName == "" then
        UpdateStatus("Enter an NPC name!", Color3.fromRGB(255, 110, 110))
        return
    end

    local success, message = TeleportToNPC()

    UpdateStatus(
        message,
        success and Color3.fromRGB(150, 220, 170)
        or Color3.fromRGB(255, 110, 110)
    )
end)

autoButton.MouseButton1Click:Connect(function()
    Enabled = not Enabled

    autoButton.Text = Enabled and "AUTO TP: ON" or "AUTO TP: OFF"
    autoButton.BackgroundColor3 = Enabled
        and Color3.fromRGB(45, 145, 95)
        or Color3.fromRGB(65, 65, 80)

    if Enabled then
        TargetName = search.Text
        UpdateStatus("Auto teleport enabled")
    else
        UpdateStatus("Auto teleport disabled")
    end
end)

