local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local Settings = {
    Enabled = false,
    Range = 30,
    Cooldown = 0.65,
    ReactionDelay = 0.05,
}

local AttackIds = {
    ["105020388135885"] = true,
    ["114981347026301"] = true,
    ["105539301376733"] = true,
    ["116640018587342"] = true,
}

local LastWeave = 0
local Connections = {}
local PacketRemote = ReplicatedStorage:WaitForChild("Packet"):WaitForChild("RemoteEvent")

local function GenerateHexString()
    local chars = "0123456789abcdef"
    local result = ""
    for i = 1, 16 do
        local rand = math.random(1, #chars)
        result = result .. chars:sub(rand, rand)
    end
    return result
end

local function BuildWeavePacket()
    local sessionStr = GenerateHexString() 
    local spyBuffer = "\0\28\11\1p\28\11\4Type\11\5Weave\0\11\1s\11\16" .. sessionStr .. "\11\1t\n\133\2351\245\129\190\218A\0\2\0\0"
    return buffer.fromstring(spyBuffer)
end

local function PerformWeave()
    if not Settings.Enabled then return end
    if os.clock() - LastWeave < Settings.Cooldown then return end
    
    LastWeave = os.clock()
    local weaveBuffer = BuildWeavePacket()
    
    pcall(function()
        PacketRemote:FireServer(weaveBuffer)
    end)
end

local function CheckAttack(enemy, track)
    if not Settings.Enabled then return end
    if not enemy.Character then return end

    local id = tostring(track.Animation.AnimationId):match("%d+")
    if not id or not AttackIds[id] then return end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local enemyRoot = enemy.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not enemyRoot then return end

    local dist = (myRoot.Position - enemyRoot.Position).Magnitude
    if dist > Settings.Range then return end

    task.delay(Settings.ReactionDelay, function()
        PerformWeave()
    end)
end

local function WatchPlayer(player)
    if player == LocalPlayer then return end

    local function setupCharacter(character)
        local humanoid = character:WaitForChild("Humanoid", 10)
        if not humanoid then return end
        local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 5)
        if not animator then return end

        Connections[#Connections + 1] = animator.AnimationPlayed:Connect(function(track)
            CheckAttack(player, track)
        end)
    end

    if player.Character then task.spawn(setupCharacter, player.Character) end
    Connections[#Connections + 1] = player.CharacterAdded:Connect(setupCharacter)
end

for _, p in ipairs(Players:GetPlayers()) do WatchPlayer(p) end
Connections[#Connections + 1] = Players.PlayerAdded:Connect(WatchPlayer)

