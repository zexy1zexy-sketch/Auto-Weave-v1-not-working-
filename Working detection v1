
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local Enabled = false
local RANGE = 30
local COOLDOWN = 0.65

local AttackIds = {
    ["105020388135885"] = true,
    ["114981347026301"] = true,
    ["105539301376733"] = true,
    ["116640018587342"] = true
}

local LastAlert = 0
local Connections = {}

local GUI = Instance.new("ScreenGui")
GUI.Name = "AutoWeaveMobile"
GUI.ResetOnSpawn = false
GUI.Parent = game:GetService("CoreGui")

local Frame = Instance.new("Frame")
Frame.Size = UDim2.fromOffset(175, 76)
Frame.Position = UDim2.new(0.5, -87, 0.72, 0)
Frame.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
Frame.Parent = GUI

Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 10)

local Toggle = Instance.new("TextButton")
Toggle.Size = UDim2.new(1, -12, 0, 32)
Toggle.Position = UDim2.fromOffset(6, 6)
Toggle.BackgroundColor3 = Color3.fromRGB(145, 45, 45)
Toggle.TextColor3 = Color3.new(1, 1, 1)
Toggle.Text = "AUTO WEAVE: OFF"
Toggle.TextSize = 13
Toggle.Font = Enum.Font.GothamBold
Toggle.Parent = Frame

Instance.new("UICorner", Toggle).CornerRadius = UDim.new(0, 7)

local Status = Instance.new("TextLabel")
Status.Size = UDim2.new(1, -12, 0, 24)
Status.Position = UDim2.fromOffset(6, 43)
Status.BackgroundTransparency = 1
Status.TextColor3 = Color3.fromRGB(210, 210, 210)
Status.Text = "Waiting..."
Status.TextSize = 11
Status.Font = Enum.Font.Gotham
Status.Parent = Frame

local function IsMoving()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    return humanoid and humanoid.MoveDirection.Magnitude > 0.05
end

local function CheckAttack(enemy, track)
    if not Enabled then return end
    if not enemy.Character then return end
    if not IsMoving() then return end

    local id = tostring(track.Animation.AnimationId):match("%d+")

    if not id or not AttackIds[id] then return end

    local myCharacter = LocalPlayer.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
    local enemyRoot = enemy.Character:FindFirstChild("HumanoidRootPart")

    if not myRoot or not enemyRoot then return end

    if (myRoot.Position - enemyRoot.Position).Magnitude > RANGE then
        return
    end

    if os.clock() - LastAlert < COOLDOWN then return end

    LastAlert = os.clock()
    Status.Text = "ATTACK DETECTED: " .. enemy.Name
end

local function WatchPlayer(player)
    if player == LocalPlayer then return end

    local function CharacterAdded(character)
        local humanoid = character:WaitForChild("Humanoid", 10)
        if not humanoid then return end

        local animator = humanoid:FindFirstChildOfClass("Animator")
            or humanoid:WaitForChild("Animator", 5)

        if not animator then return end

        Connections[#Connections + 1] =
            animator.AnimationPlayed:Connect(function(track)
                CheckAttack(player, track)
            end)
    end

    if player.Character then
        task.spawn(CharacterAdded, player.Character)
    end

    Connections[#Connections + 1] =
        player.CharacterAdded:Connect(CharacterAdded)
end

for _, player in ipairs(Players:GetPlayers()) do
    WatchPlayer(player)
end

Connections[#Connections + 1] =
    Players.PlayerAdded:Connect(WatchPlayer)

Toggle.MouseButton1Click:Connect(function()
    Enabled = not Enabled

    Toggle.Text = Enabled and "AUTO WEAVE: ON" or "AUTO WEAVE: OFF"

    Toggle.BackgroundColor3 = Enabled
        and Color3.fromRGB(35, 145, 85)
        or Color3.fromRGB(145, 45, 45)

    Status.Text = Enabled and "Watching for attacks..." or "Disabled"
end)

GUI.Destroying:Connect(function()
    for _, connection in ipairs(Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
end)
